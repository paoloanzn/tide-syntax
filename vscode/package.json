{
  "name": "tide-syntax",
  "displayName": "Tide Syntax",
  "description": "Syntax highlighting for the Tide language (.tid files).",
  "version": "0.1.0",
  "publisher": "paoloanzn",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/paoloanzn/tide-syntax.git"
  },
  "homepage": "https://github.com/paoloanzn/tide-syntax#readme",
  "bugs": {
    "url": "https://github.com/paoloanzn/tide-syntax/issues"
  },
  "keywords": [
    "tide",
    "tid",
    "syntax",
    "highlighting"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "files": [
    "LICENSE",
    "language-configuration.json",
    "syntaxes/"
  ],
  "contributes": {
    "languages": [
      {
        "id": "tide",
        "aliases": [
          "Tide",
          "tide"
        ],
        "extensions": [
          ".tid"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "tide",
        "scopeName": "source.tide",
        "path": "./syntaxes/tide.tmLanguage.json"
      }
    ]
  }
}
