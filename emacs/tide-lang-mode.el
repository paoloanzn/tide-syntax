;;;; Indentation

(defun tide-lang-indent-line ()
  "Indent the current line by the depth of the braces around it."
  (interactive)
  (let* ((state (save-excursion (syntax-ppss (line-beginning-position))))
         (indent (save-excursion
                   (back-to-indentation)
                   (let ((depth (car (syntax-ppss))))
                     (when (looking-at "\\s)")
                       (setq depth (1- depth)))
                     (* tide-lang-indent-offset (max depth 0))))))
    (cond ((nth 8 state) 'noindent)
          ((> (current-column) (current-indentation))
           (save-excursion (indent-line-to indent)))
          (t (indent-line-to indent)))))

;;;; Compilation

(defconst tide-lang--compilation-regexp
  (rx bol
      (group-n 1 (not (in " \n")) (*? nonl)) ":"
      (group-n 2 (+ digit)) ":"
      (group-n 3 (+ digit)) ": "
      (or "error" (group-n 4 "warning") (group-n 5 "note")) ": ")
  "Matches Tide diagnostics: FILE:LINE:COLUMN: SEVERITY: MESSAGE.")

(add-to-list 'compilation-error-regexp-alist-alist
             `(tide-lang ,tide-lang--compilation-regexp 1 2 3 (4 . 5)))
(add-to-list 'compilation-error-regexp-alist 'tide-lang)

;;;; Mode

;;;###autoload
(define-derived-mode tide-lang-mode prog-mode "Tide"
  "Major mode for editing Tide scripts.

\\[compile] defaults to `tide check' on the visited file; set
`tide-lang-program' if the executable is not on variable `exec-path'.  The
command runs with NO_COLOR=1, so diagnostics stay parseable."
  :group 'tide-lang
  (setq-local comment-start "// ")
  (setq-local comment-end "")
  (setq-local comment-start-skip "\\(?://+\\|/\\*+\\)\\s-*")
  (setq-local font-lock-defaults
              '(tide-lang--font-lock-keywords
                nil nil nil nil
                (font-lock-syntactic-face-function
                 . tide-lang--syntactic-face)))
  (setq-local syntax-propertize-function #'tide-lang--syntax-propertize)
  (setq-local indent-line-function #'tide-lang-indent-line)
  (setq-local electric-indent-chars (append "{}" electric-indent-chars))
  (setq-local compilation-environment
              (cons "NO_COLOR=1" compilation-environment))
  (when buffer-file-name
    (setq-local compile-command
                (concat tide-lang-program " check "
                        (shell-quote-argument
                         (file-name-nondirectory buffer-file-name))))))

;;;###autoload
(add-to-list 'auto-mode-alist '("\\.tid\\'" . tide-lang-mode))

(provide 'tide-lang-mode)
